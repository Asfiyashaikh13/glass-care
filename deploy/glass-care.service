[Unit]
Description=Glass Care estimator and local Ollama chat proxy
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=glasscare
Group=glasscare
WorkingDirectory=/opt/glass-care
EnvironmentFile=/etc/glass-care/glass-care.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/glass-care/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
